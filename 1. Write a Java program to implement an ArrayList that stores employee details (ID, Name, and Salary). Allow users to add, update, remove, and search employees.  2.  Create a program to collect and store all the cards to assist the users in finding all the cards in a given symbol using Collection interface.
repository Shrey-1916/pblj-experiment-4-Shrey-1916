import java.util.ArrayList;
import java.util.Collection;
import java.util.Scanner;

class Card {
    private String suit;
    private String rank;

    public Card(String suit, String rank) {
        this.suit = suit;
        this.rank = rank;
    }

    public String getSuit() {
        return suit;
    }

    public String getRank() {
        return rank;
    }

    @Override
    public String toString() {
        return rank + " of " + suit;
    }
}

public class CardCollection {

    private Collection<Card> deck;

    public CardCollection() {
        deck = new ArrayList<>();
        generateDeck();
    }

    // Method to generate a deck of cards
    private void generateDeck() {
        String[] suits = {"Hearts", "Diamonds", "Clubs", "Spades"};
        String[] ranks = {"Ace", "2", "3", "4", "5", "6", "7", "8", "9", "10", "Jack", "Queen", "King"};

        for (String suit : suits) {
            for (String rank : ranks) {
                deck.add(new Card(suit, rank));
            }
        }
    }

    // Method to find all cards of a given suit
    public void findCardsBySuit(String suit) {
        boolean found = false;
        System.out.println("Cards of " + suit + ":");
        for (Card card : deck) {
            if (card.getSuit().equalsIgnoreCase(suit)) {
                System.out.println(card);
                found = true;
            }
        }

        if (!found) {
            System.out.println("No cards found for the given suit.");
        }
    }

    // Method to display all cards in the deck
    public void displayAllCards() {
        System.out.println("Deck of Cards:");
        for (Card card : deck) {
            System.out.println(card);
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        CardCollection cardCollection = new CardCollection();

        while (true) {
            System.out.println("\nCard Collection System:");
            System.out.println("1. Find Cards by Suit");
            System.out.println("2. Display All Cards");
            System.out.println("3. Exit");
            System.out.print("Choose an option: ");
            int choice = scanner.nextInt();
            scanner.nextLine();  // Consume the newline character

            switch (choice) {
                case 1:
                    // Find cards by suit
                    System.out.print("Enter suit (Hearts, Diamonds, Clubs, Spades): ");
                    String suit = scanner.nextLine();
                    cardCollection.findCardsBySuit(suit);
                    break;

                case 2:
                    // Display all cards
                    cardCollection.displayAllCards();
                    break;

                case 3:
                    // Exit
                    System.out.println("Exiting...");
                    scanner.close();
                    return;

                default:
                    System.out.println("Invalid choice! Please try again.");
            }
        }
    }
}



